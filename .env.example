DOCUPEDIA_BASE_URL=https://docupedia.example.com
DOCUPEDIA_USERNAME=replace-me
DOCUPEDIA_API_TOKEN=replace-me
S3_ENDPOINT=https://objectstore.example.com
S3_REGION=eu-central-1
S3_BUCKET=replace-me
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
AICORE_TOKEN_URL=https://auth.example.com/oauth/token
AICORE_CLIENT_ID=replace-me
AICORE_CLIENT_SECRET=replace-me
AICORE_API_URL=https://api.ai.example.com
AICORE_RESOURCE_GROUP=default
AICORE_S3_GENERIC_SECRET=replace-me
AICORE_ORCHESTRATION_DEPLOYMENT_ID=replace-me

# Azure Cosmos DB for MongoDB
COSMOS_MONGO_ENABLED=true
COSMOS_MONGO_URI=mongodb://<account>:<key>@<account>.mongo.cosmos.azure.com:10255/<database>?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000
COSMOS_MONGO_DATABASE=<database>
COSMOS_MONGO_MAX_QUERY_RESULTS=500
