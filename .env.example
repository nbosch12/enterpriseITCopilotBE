DOCUPEDIA_BASE_URL=https://docupedia.example.com
DOCUPEDIA_USERNAME=replace-me
DOCUPEDIA_API_TOKEN=replace-me
S3_ENDPOINT=https://objectstore.example.com
S3_REGION=eu-central-1
S3_BUCKET=replace-me
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
AICORE_TOKEN_URL=https://auth.example.com/oauth/token
AICORE_CLIENT_ID=replace-me
AICORE_CLIENT_SECRET=replace-me
AICORE_API_URL=https://api.ai.example.com
AICORE_RESOURCE_GROUP=default
AICORE_S3_GENERIC_SECRET=replace-me
AICORE_ORCHESTRATION_DEPLOYMENT_ID=replace-me

# --- Azure Cosmos DB for MongoDB (QR code collections) ---
# Leave COSMOS_MONGO_ENABLED=false to run the backend without Cosmos DB.
COSMOS_MONGO_ENABLED=false
# Full Cosmos DB connection string from the Azure portal. Contains the account key - keep it secret.
MONGODB_URI=mongodb://<account>:<key>@<host>:10255/<database>?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000
MONGODB_DATABASE=qrcode
COSMOS_MONGO_MAX_QUERY_RESULTS=500
COSMOS_MONGO_MAX_SCAN_DOCUMENTS=50000
COSMOS_MONGO_DATE_FILTER_STRATEGY=AUTO

# --- Deterministic analytics over the QR code collections ---
ANALYTICS_ENABLED=true
ANALYTICS_WEEK_OF_MONTH_MODE=DAY_BLOCKS
ANALYTICS_MAX_CONTEXT_CHARACTERS=12000
ANALYTICS_MAX_CONTEXT_RECORDS=60

# --- Object-store location for exported MongoDB grounding chunks (optional) ---
GROUNDING_REPOSITORY_ID=
GROUNDING_ROOT_PREFIX=
